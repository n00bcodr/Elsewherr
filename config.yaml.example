# Elsewherr — example configuration
# Copy this file to config.yaml and fill in your details.

tmdb:
  api_key: "YOUR_TMDB_API_KEY"   # https://www.themoviedb.org/settings/api
  region: "US"                   # 2-letter region code — see res/regions.txt

# radarr / sonarr can be a single block, or a list for multiple instances
# (e.g. HD + 4K). "name" is optional but must be unique per instance.
radarr:
  - name: "Radarr"
    enabled: true
    url: "http://localhost:7878"
    api_key: "YOUR_RADARR_API_KEY"
  - name: "Radarr 4K"
    enabled: true
    url: "http://localhost:7879"
    api_key: "YOUR_RADARR_4K_API_KEY"

sonarr:
  - name: "Sonarr"
    enabled: true
    url: "http://localhost:8989"
    api_key: "YOUR_SONARR_API_KEY"
  - name: "Sonarr 4K"
    enabled: true
    url: "http://localhost:8990"
    api_key: "YOUR_SONARR_4K_API_KEY"

# Optional: after tags change, start Jellyfin Enhanced's "Sync Tags from *arr to Jellyfin" task.
# Needs the Jellyfin Enhanced plugin with Arr Tags Sync enabled, and a Jellyfin API key
# (Dashboard -> API Keys).
jellyfin:
  enabled: false
  url: "http://localhost:8096"
  api_key: "YOUR_JELLYFIN_API_KEY"

discord:
  enabled: false
  webhook_url: ""

# Providers to track — names must match TMDb exactly.
# Run res_generator.py to regenerate the full list in res/providers.txt.
providers:
  - Netflix
  - Disney Plus
  - Amazon Prime Video
  - Apple TV Plus
  - Max
  - Hulu
  - Peacock Premium
  - Paramount Plus

# Prefix applied to every tag this script creates.
# Elsewherr removes all tags with this prefix before re-applying current ones,
# so a stale tag (show left a service) is cleaned up automatically.
# WARNING: do NOT use a prefix that could match tags you've created manually.
prefix: "elsewherr-"
